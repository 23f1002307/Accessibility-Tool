{
  "manifest_version": 3,

  "name": "Accessibility Inspector Tool",
  "description": "A semantic accessibility inspection tool for selecting webpage regions and extracting accessibility-related information.",
  "version": "1.0.0",

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Accessibility Inspector"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/anchor.js",
        "content/selectionManager.js",
        "content/domUtils.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "styles/overlay.css"
      ]
    }
  ],

  "commands": {
    "mark_start": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Mark start anchor"
    },
    "mark_end": {
      "suggested_key": {
        "default": "Ctrl+Alt+E"
      },
      "description": "Mark end anchor"
    },
    "inspect_selection": {
      "suggested_key": {
        "default": "Ctrl+Alt+C"
      },
      "description": "Open inspector"
    }
  }
}