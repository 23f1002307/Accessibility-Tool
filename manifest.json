{
  "manifest_version": 3,
  "name": "Accessibility Inspector Tool",
  "description": "A semantic accessibility inspection tool for selecting webpage regions and extracting accessibility information.",
  "version": "1.0.0",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Accessibility Inspector"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/anchor.js",
        "content/selectionManager.js",
        "utils/domUtils.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": [
        "styles/overlay.css"
      ]
    }
  ],

  "commands": {
    "mark_start": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Mark start anchor"
    },

    "mark_end": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Mark end anchor"
    },

    "inspect_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open inspector"
    },

    "take_screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Capture screenshot of selected region"
    }
  }
}